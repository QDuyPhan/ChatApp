<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android">

  <data>

    <variable
        name="viewModel"
        type="com.quangduy.chatapp.viewmodel.ChatFromHomeViewModel" />
  </data>

  <androidx.constraintlayout.widget.ConstraintLayout xmlns:app="http://schemas.android.com/apk/res-auto"
      android:layout_width="match_parent"
      android:layout_height="match_parent"
      android:background="#F8F9FD">

    <!-- Back button -->
    <ImageView
        android:id="@+id/chatBackBtn"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:layout_margin="16dp"
        android:background="@drawable/bg_circle_white"
        android:contentDescription="Back"
        android:padding="8dp"
        android:src="@drawable/ic_arrow_back"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- User avatar & name -->
    <de.hdodenhof.circleimageview.CircleImageView
        android:id="@+id/chatImageViewUser"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_marginStart="12dp"
        android:layout_marginTop="16dp"
        android:src="@drawable/person"
        app:civ_border_color="#FE2C54"
        app:civ_border_width="2dp"
        app:layout_constraintStart_toEndOf="@id/chatBackBtn"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/chatUserName"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:text="User Name"
        android:textColor="#1E1E1E"
        android:textSize="16sp"
        app:layout_constraintStart_toEndOf="@id/chatImageViewUser"
        app:layout_constraintTop_toTopOf="@id/chatImageViewUser" />

    <TextView
        android:id="@+id/chatUserStatus"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:text="Online"
        android:textColor="#7D7D7D"
        android:textSize="12sp"
        app:layout_constraintStart_toStartOf="@id/chatUserName"
        app:layout_constraintTop_toBottomOf="@id/chatUserName" />

    <!-- RecyclerView -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/messagesRecyclerView"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:clipToPadding="false"
        android:padding="8dp"
        app:layout_constraintBottom_toTopOf="@id/layoutChatbox"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/chatImageViewUser" />

    <!-- Chat Box -->
    <LinearLayout
        android:id="@+id/layoutChatbox"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:background="@android:color/white"
        android:orientation="horizontal"
        android:padding="8dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

      <EditText
          android:id="@+id/editTextMessage"
          android:layout_width="0dp"
          android:layout_height="48dp"
          android:layout_weight="1"
          android:background="@drawable/bg_chat_input"
          android:hint="Type a message..."
          android:inputType="textMultiLine"
          android:maxLines="4"
          android:padding="12dp"
          android:textColor="#000000"
          android:textColorHint="#999999" />

      <ImageButton
          android:id="@+id/sendBtn"
          android:layout_width="48dp"
          android:layout_height="48dp"
          android:layout_marginStart="8dp"
          android:background="@drawable/bg_circle_black"
          android:contentDescription="Send"
          android:src="@drawable/ic_send"
          app:tint="@color/white" />
    </LinearLayout>
  </androidx.constraintlayout.widget.ConstraintLayout>
</layout>