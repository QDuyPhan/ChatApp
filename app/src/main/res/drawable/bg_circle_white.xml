<?xml version="1.0" encoding="utf-8"?>
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
  <!-- Background color -->
  <solid android:color="#FFFFFF" />

  <!-- Border color & width -->
  <stroke
      android:width="1.5dp"
      android:color="#DDDDDD" /> <!-- Hoặc đổi sang màu bạn muốn -->

  <!-- Optional shadow on older APIs (you can skip this if using elevation) -->
  <corners android:radius="@dimen/_10sdp" />
</shape>

